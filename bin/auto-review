#!/usr/bin/env bash
# Polls GitHub for PRs awaiting my review; pre-runs /code-review headlessly
# so the session is ready to resume. Never writes to GitHub.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_DIR="${AUTO_REVIEW_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/auto-review}"
STATE_DIR="${AUTO_REVIEW_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/auto-review}"
CONFIG="$CONFIG_DIR/config.json"
STATE="$STATE_DIR/state.json"
LOG_FILE="$STATE_DIR/auto-review.log"
LOCK="$STATE_DIR/.lock"

if [ ! -f "$CONFIG" ]; then
  echo "no config at $CONFIG — copy $REPO_DIR/config.example.json there and fill it in" >&2
  exit 1
fi

CLAUDE_BIN="${CLAUDE_BIN:-$(jq -r '.claude_bin // "claude"' "$CONFIG")}"
GH_BIN="${GH_BIN:-gh}"
NOTIFY="${AUTO_REVIEW_NOTIFY:-$(jq -r 'if .notifications == false then 0 else 1 end' "$CONFIG")}"
cfg_claude_home="$(jq -r '.claude_config_dir // empty' "$CONFIG")"
if [ -n "$cfg_claude_home" ]; then
  export CLAUDE_CONFIG_DIR="$cfg_claude_home"
fi

ALLOWED_TOOLS='Read,Grep,Glob,Task,Agent,TodoWrite,Skill(code-review),Skill(code-review:code-review),Bash(gh pr view:*),Bash(gh pr diff:*),Bash(gh pr checks:*),Bash(gh pr list:*),Bash(git log:*),Bash(git show:*),Bash(git diff:*),Bash(git fetch:*),Bash(git worktree:*),Bash(git checkout:*),Bash(git branch:*),Bash(cd:*),Bash(echo:*)'

review_prompt() { # $1 PR number, $2 optional extra reviewer context
  printf 'Create a git worktree for PR #%s at .worktrees/pr-%s (fetch the PR branch first). Do ALL branch checkouts and code inspection inside that worktree — never modify the main working copy. Then review the PR by running /code-review %s. Keep the worktree in place afterwards so follow-up questions can use it.' \
    "$1" "$1" "$1"
  if [ -n "${2:-}" ]; then
    printf '\n\nAdditional context from the reviewer: %s' "$2"
  fi
}

CURRENT_KEY=""
REVIEWED=0 FAILED=0 SKIPPED=0

timestamp() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

log() { # to the log file always; echoed live when running in a terminal
  local line; line="$(date '+%Y-%m-%d %H:%M:%S') $*"
  printf '%s\n' "$line" >>"$LOG_FILE"
  if [ -t 2 ]; then printf '%s\n' "$line" >&2; fi
}

notify() { # $1 title, $2 body — double quotes stripped, not escaped
  [ "$NOTIFY" = 1 ] || return 0
  osascript -e "display notification \"${2//\"/}\" with title \"${1//\"/}\"" >/dev/null 2>&1 || true
}

acquire_lock() {
  if ! mkdir "$LOCK" 2>/dev/null; then
    local pid; pid=$(cat "$LOCK/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      log "lock held by pid $pid, skipping run"; exit 0
    fi
    rm -rf "$LOCK"; mkdir "$LOCK"
  fi
  echo $$ >"$LOCK/pid"
  trap 'rm -rf "$LOCK"' EXIT
}

normalize_key() { # accepts ORG/REPO#N or a GitHub PR URL; validates the result
  local in=$1
  if [[ "$in" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
    in="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}#${BASH_REMATCH[3]}"
  fi
  if [[ ! "$in" =~ ^[^/#[:space:]]+/[^/#[:space:]]+#[0-9]+$ ]]; then
    echo "cannot parse '$1' — expected ORG/REPO#NUM or a GitHub PR URL" >&2
    return 1
  fi
  echo "$in"
}

state_get() { jq -r --arg k "$1" '.[$k] // empty' "$STATE"; }

state_set() { # $1 key, $2 json object
  local tmp; tmp=$(mktemp)
  jq --arg k "$1" --argjson v "$2" '.[$k] = $v' "$STATE" >"$tmp" && mv "$tmp" "$STATE"
}

state_status() { # $1 key, $2 status, $3 error message (optional)
  local tmp; tmp=$(mktemp)
  jq --arg k "$1" --arg s "$2" --arg e "${3:-}" --arg d "$(timestamp)" \
    '.[$k].status = $s | .[$k].updated_at = $d
     | if $e != "" then .[$k].error = $e else . end' \
    "$STATE" >"$tmp" && mv "$tmp" "$STATE"
}

on_interrupt() {
  trap - INT TERM
  if [ -n "$CURRENT_KEY" ]; then
    state_status "$CURRENT_KEY" canceled "run interrupted"
    log "CANCELED $CURRENT_KEY (interrupted) — retry with: auto-review --retry $CURRENT_KEY"
  else
    log "canceled (interrupted)"
  fi
  exit 130
}

reconcile_orphans() { # any "reviewing" entry while we hold the lock is from a dead run
  local k
  for k in $(jq -r 'to_entries[] | select(.value.status == "reviewing") | .key' "$STATE"); do
    state_status "$k" failed "previous run died mid-review"
    log "ORPHAN $k: previous run died mid-review, marked failed — retry with: auto-review --retry $k"
  done
}

fetch_candidates() { # TSV: nameWithOwner, number, title, url (non-draft only)
  local org
  for org in $(jq -r '.orgs[]' "$CONFIG"); do
    "$GH_BIN" search prs --review-requested=@me --state=open --owner "$org" \
        --json number,title,url,isDraft,repository 2>>"$LOG_FILE" |
      jq -r '.[] | select(.isDraft | not) |
             [.repository.nameWithOwner, (.number|tostring), .title, .url] | @tsv' \
      || log "gh search failed for org $org"
  done
}

review_pr() { # $1 key, $2 repo, $3 number, $4 title, $5 url, $6 optional note
  local key=$1 repo=$2 number=$3 title=$4 url=$5 note=${6:-}
  local local_path out session_id
  local_path=$(jq -r --arg r "$repo" '.repos[$r] // empty' "$CONFIG")
  if [ -z "$local_path" ] || [ ! -d "$local_path" ]; then
    log "SKIP $key: no local clone mapped"
    state_set "$key" "$(jq -n --arg t "$title" --arg u "$url" --arg d "$(timestamp)" \
      '{status:"skipped", title:$t, url:$u, updated_at:$d}')"
    notify "auto-review: no local clone" "$key"
    SKIPPED=$((SKIPPED+1))
    return 0
  fi
  state_set "$key" "$(jq -n --arg t "$title" --arg u "$url" --arg p "$local_path" \
    --arg d "$(timestamp)" \
    '{status:"reviewing", title:$t, url:$u, local_path:$p, updated_at:$d}')"
  CURRENT_KEY=$key
  log "REVIEW $key in $local_path — headless /code-review running, this takes a few minutes"
  if out=$(cd "$local_path" && "$CLAUDE_BIN" -p "$(review_prompt "$number" "$note")" \
      --output-format json --permission-mode dontAsk \
      --allowedTools "$ALLOWED_TOOLS" 2>>"$LOG_FILE"); then
    session_id=$(printf '%s' "$out" | jq -r '.session_id // empty' 2>/dev/null || true)
  else
    session_id=""
  fi
  if [ -n "$session_id" ]; then
    state_set "$key" "$(jq -n --arg s "$session_id" --arg t "$title" --arg u "$url" \
      --arg p "$local_path" --arg d "$(timestamp)" \
      '{status:"ready", session_id:$s, title:$t, url:$u, local_path:$p, updated_at:$d}')"
    log "READY $key session=$session_id — run \`reviews\` to open it"
    notify "Review ready: $key" "$title"
    REVIEWED=$((REVIEWED+1))
  else
    state_set "$key" "$(jq -n --arg t "$title" --arg u "$url" --arg p "$local_path" \
      --arg d "$(timestamp)" \
      '{status:"failed", title:$t, url:$u, local_path:$p,
        error:"claude run failed, see auto-review.log", updated_at:$d}')"
    log "FAILED $key — retry with: auto-review --retry $key"
    notify "Review FAILED: $key" "$title"
    FAILED=$((FAILED+1))
  fi
  CURRENT_KEY=""
}

main() {
  mkdir -p "$STATE_DIR"
  [ -s "$STATE" ] || echo '{}' >"$STATE"
  local dry=0
  if [ "${1:-}" = "--dry-run" ]; then dry=1; fi
  acquire_lock
  trap on_interrupt INT TERM
  reconcile_orphans
  if [ "${1:-}" = "--retry" ]; then
    local key; key=$(normalize_key "${2:?usage: auto-review --retry ORG/REPO#NUM [note]}") || exit 1
    local entry; entry=$(state_get "$key")
    if [ -z "$entry" ]; then echo "unknown key: $key" >&2; exit 1; fi
    review_pr "$key" "${key%#*}" "${key##*#}" \
      "$(jq -r '.title // ""' <<<"$entry")" "$(jq -r '.url // ""' <<<"$entry")" "${3:-}"
    return 0
  fi
  if [ "${1:-}" = "--review" ]; then # force-review any PR, ignoring the trigger
    local key; key=$(normalize_key "${2:?usage: auto-review --review ORG/REPO#NUM [note]}") || exit 1
    local note="${3:-}" repo number info title url
    repo="${key%#*}" number="${key##*#}"
    if ! info=$("$GH_BIN" pr view "$number" --repo "$repo" --json title,url 2>>"$LOG_FILE"); then
      echo "cannot fetch $key from GitHub (does the PR exist?)" >&2; exit 1
    fi
    title=$(jq -r '.title // ""' <<<"$info")
    url=$(jq -r '.url // ""' <<<"$info")
    review_pr "$key" "$repo" "$number" "$title" "$url" "$note"
    return 0
  fi
  log "polling $(jq -r '.orgs | join(", ")' "$CONFIG") for review requests"
  local repo number title url key
  while IFS=$'\t' read -r repo number title url; do
    [ -n "$repo" ] || continue
    key="$repo#$number"
    [ -z "$(state_get "$key")" ] || continue
    if [ "$dry" -eq 1 ]; then
      echo "would review: $key — $title"
    else
      review_pr "$key" "$repo" "$number" "$title" "$url"
    fi
  done < <(fetch_candidates)
  if [ "$dry" -eq 1 ]; then
    log "poll complete (dry run)"
  elif [ $((REVIEWED + FAILED + SKIPPED)) -eq 0 ]; then
    log "poll complete: nothing new"
  else
    log "poll complete: $REVIEWED reviewed, $FAILED failed, $SKIPPED skipped"
  fi
}

main "$@"
