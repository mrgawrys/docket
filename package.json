{
  "name": "docket",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts",
    "test": "bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "bun build --compile src/main.ts --outfile dist/docket",
    "reinstall": "bun run build && install -m 755 dist/docket \"$HOME/.local/bin/docket\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  }
}
